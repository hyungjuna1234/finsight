          "severity": { "type": "string", "enum": ["critical", "major", "minor", "nit"] },
          "dimensions": { "type": "array", "items": { "type": "string" } },
          "body": { "type": "string", "description": "인라인 4줄: [심각도] 제목 / TL;DR / ✓ Good / → Fix" }
